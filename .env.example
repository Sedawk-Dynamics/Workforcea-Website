# Contact form delivery (app/api/contact/route.ts).
# Without these the form returns a clear "not connected yet" error rather than
# a fake success, and the enquiry is logged to the server console.

# Resend API key — https://resend.com
RESEND_API_KEY=

# Verified sender on your Resend domain, e.g. "Workforcea <website@workforcea.com>"
CONTACT_FROM_EMAIL=

# Optional: where enquiries land. Defaults to SITE.email in lib/site.ts
CONTACT_TO_EMAIL=
